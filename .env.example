# ---- Layer 1: LLM (parsing only) -------------------------------------------
# Free tier, no card required: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_google_ai_studio_key_here
GEMINI_MODEL=gemini-2.5-flash

# ---- Channel: Twilio WhatsApp Sandbox --------------------------------------
# https://console.twilio.com  ->  Messaging  ->  Try it out  ->  WhatsApp
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Public base URL of this service, used to validate Twilio's request signature.
# Must match the webhook URL you paste into the Twilio console exactly.
PUBLIC_BASE_URL=https://your-app.onrender.com
# Set to false only for local testing without a public URL.
VALIDATE_TWILIO_SIGNATURE=true

# ---- Layer 2: storage ------------------------------------------------------
DATABASE_PATH=data/training_log.db
