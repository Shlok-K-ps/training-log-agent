# ---- Layer 1: LLM (parsing only) -------------------------------------------
# Free tier, no card required: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_google_ai_studio_key_here
GEMINI_MODEL=gemini-2.5-flash

# ---- Channel: Telegram (permanent free portfolio demo) ---------------------
# Create a bot with https://t.me/BotFather and copy its token and username.
# The app registers its own webhook at startup. Do not paste the token into chat.
TELEGRAM_BOT_TOKEN=123456789:your_bot_token
TELEGRAM_BOT_USERNAME=your_bot_username_without_at
# Letters, numbers, underscore and hyphen only.
TELEGRAM_WEBHOOK_SECRET=replace_with_a_long_random_value
TELEGRAM_LINK_SECRET=replace_with_a_different_long_random_value

# ---- Optional channel: Vonage WhatsApp Sandbox -----------------------------
# https://dashboard.nexmo.com/messages/sandbox
# Once these four values are present, the app activates Vonage automatically.
VONAGE_API_KEY=your_vonage_api_key
VONAGE_API_SECRET=your_vonage_api_secret
VONAGE_SANDBOX_NUMBER=the_number_shown_in_the_vonage_sandbox
# Generate a long random value. Add it to both webhook URLs as ?token=<value>.
VONAGE_WEBHOOK_SECRET=replace_with_at_least_32_random_characters

# ---- Legacy alternative: Twilio WhatsApp Sandbox --------------------------
# Used only when Vonage is not configured.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Public base URL of this service, used to validate Twilio's request signature
# and build other integration callbacks.
# Must match the webhook URL you paste into the Twilio console exactly.
PUBLIC_BASE_URL=https://your-app.onrender.com
# Set to false only for local testing without a public URL.
VALIDATE_TWILIO_SIGNATURE=true
# Legacy morning scheduler. Never runs while ENABLE_AGENT_LOOP is true.
ENABLE_MORNING_SCHEDULER=false

# ---- Optional calendar + travel planning ----------------------------------
# OAuth web client in Google Cloud. Add this exact redirect URI:
# https://your-app.onrender.com/integrations/google/calendar/callback
GOOGLE_CALENDAR_CLIENT_ID=your_google_oauth_web_client_id
GOOGLE_CALENDAR_CLIENT_SECRET=your_google_oauth_web_client_secret
# Restrict this key to the Routes API and your production service.
GOOGLE_MAPS_API_KEY=your_google_maps_routes_key
# Generate two independent secrets; never commit their real values.
OAUTH_STATE_SECRET=replace_with_at_least_24_random_characters
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CALENDAR_TOKEN_ENCRYPTION_KEY=replace_with_a_fernet_key

# Exact regimens a team operator has approved separately from athlete messages.
# The final field confirms the product/batch was independently verified.
# Format: name|dose|unit|timing|approver|batch_verified (semicolon-separated)
# Leave empty to schedule no supplements (fail-closed default).
TEAM_APPROVED_SUPPLEMENT_REGIMENS=

# ---- Layer 2: storage ------------------------------------------------------
DATABASE_PATH=data/training_log.db
# Durable Postgres (e.g. Neon free tier). When set, it replaces the SQLite file.
# Required for any public deployment with ENABLE_AGENT_LOOP=true; otherwise the
# agent stays blocked and /health reports "degraded". Local development may omit it.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ---- The training-day agent ------------------------------------------------
ENABLE_AGENT_LOOP=true
# Tick every minute while the process is awake (the signed endpoint covers sleep).
AGENT_BACKGROUND_TICKS=true
# 1 = real time. For a live demo, 0.02 turns a 90-minute follow-up into ~2 minutes.
AGENT_TIME_SCALE=1
# Shared with the GitHub Actions workflow that calls /internal/agent/tick.
AGENT_TICK_SECRET=replace_with_a_long_random_value

# ---- Coach identity (no passwords) -----------------------------------------
# Signs the 15-minute console links the bot sends to the coach's Telegram chat.
# Leave empty locally (with no PUBLIC_BASE_URL) to open the console directly.
COACH_LINK_SECRET=
# The coach sends "/coach <this code>" to the bot once to link their Telegram.
COACH_SETUP_CODE=replace_with_a_long_random_code

# ---- Layer 4: the coach console --------------------------------------------
COACH_NAME=Coach
# An athlete with no logs for this many days is surfaced as gone quiet.
COACH_SILENT_AFTER_DAYS=7
# Nothing proactive is sent until a coach approves it at /coach/outbox.
# Local hour at which tomorrow's messages are drafted for review.
COACH_DRAFT_HOUR=20
# An injury flag open this long with no update is marked stale.
INJURY_STALE_AFTER_DAYS=21
